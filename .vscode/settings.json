{
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.analysis.exclude": [
    "**/venv/**",
    "**/node_modules/**",
    "**/graphify-out/**"
  ],
  "files.watcherExclude": {
    "**/venv/**": true,
    "**/node_modules/**": true,
    "**/graphify-out/**": true,
    "**/.git/**": true
  },
  "search.exclude": {
    "**/venv": true,
    "**/node_modules": true,
    "**/graphify-out": true
  },
  "editor.semanticHighlighting.enabled": false,
  "sqltools.connections": [
    {
      "ssh": "Disabled",
      "previewLimit": 50,
      "server": "localhost",
      "port": 5432,
      "driver": "PostgreSQL",
      "name": "real-time-chat-conn",
      "database": "fastapi_chat_db",
      "username": "postgres",
      "password": "password"
    }
  ]
}
